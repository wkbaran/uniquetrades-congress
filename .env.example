# Required for SEC EDGAR API access (public domain, no cost).
# Format: "Your Name your@email.com"
SEC_USER_AGENT=Your Name your@email.com

# Set to "fmp" to use Financial Modeling Prep instead of SEC EDGAR + StockWatcher.
# Used during parallel validation phase. Default: open (public-domain sources).
# DATA_SOURCE=fmp

# Only needed when DATA_SOURCE=fmp
# FMP_API_KEY=your_fmp_api_key_here

# OCR of scanned House PTRs and Senate paper filings, via a local Ollama vision model.
# The daily run skips OCR (with a warning) if Ollama isn't reachable.
# OLLAMA_URL=http://localhost:11434
# OCR_MODEL=qwen3.6:27b
# Chambers whose scanned filings are OCR'd (comma-separated)
# OCR_CHAMBERS=house,senate
# Pages OCR'd per daily run; bigger backlogs are left for ocr-catchup.ps1
# OCR_DAILY_MAX_PAGES=60
# OCR_TIMEOUT_MS=600000

# AWS S3 publishing
# S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id
